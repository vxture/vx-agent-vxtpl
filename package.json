{
  "name": "vxture-vxtpl",
  "version": "0.0.0",
  "private": true,
  "description": "vxtpl - a deployed Vxture product and the reference build new product repos are copied from.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "nanoid@<3.3.17": ">=3.3.17",
      "valibot@<1.4.2": ">=1.4.2",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "mysql2@<3.23.1": ">=3.23.1",
      "hono@<4.13.16": ">=4.13.16",
      "fast-uri@<4.2.3": ">=4.2.3",
      "next@<15.5.29": "15.5.29",
      "sharp@<0.35.5": ">=0.35.5",
      "@hono/node-server@>=2.0.0 <2.1.6": "2.1.6",
      "effect@>=3.0.0 <3.22.1": "3.22.1",
      "source-map-js@<1.2.2": "1.2.2"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @vxtpl/app dev",
    "build": "pnpm --filter @vxtpl/app build",
    "start": "pnpm --filter @vxtpl/app start",
    "doctor": "node scripts/doctor/check-product.mjs",
    "test": "pnpm --recursive --if-present test",
    "type-check:all": "pnpm --recursive --if-present type-check",
    "lint": "pnpm --recursive --if-present lint",
    "lint:docs-numbering": "node scripts/guardrails/check-docs-numbering.mjs --strict",
    "lint:data-design": "node scripts/guardrails/check-data-architecture.mjs --strict",
    "lint:placeholders": "node scripts/guardrails/check-no-placeholders.mjs --strict",
    "lint:ports": "node scripts/guardrails/check-port-consistency.mjs --strict",
    "lint:ruleset": "node scripts/guardrails/check-ruleset.mjs --strict",
    "lint:sca": "node scripts/guardrails/check-sca-consistency.mjs --strict"
  }
}
