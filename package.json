{
  "name": "vxture-vxtpl",
  "version": "0.0.0",
  "private": true,
  "description": "vxtpl - a deployed Vxture product and the reference build new product repos are copied from.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "hono@<4.12.34": ">=4.12.34",
      "nanoid@<3.3.17": ">=3.3.17",
      "fast-uri@<3.1.5": ">=3.1.5",
      "valibot@<1.4.2": ">=1.4.2",
      "sharp@<0.35.0": ">=0.35.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @vxtpl/app dev",
    "build": "pnpm --filter @vxtpl/app build",
    "start": "pnpm --filter @vxtpl/app start",
    "test": "pnpm --recursive --if-present test",
    "type-check:all": "pnpm --recursive --if-present type-check",
    "lint": "pnpm --recursive --if-present lint",
    "lint:docs-numbering": "node scripts/guardrails/check-docs-numbering.mjs --strict",
    "lint:data-design": "node scripts/guardrails/check-data-architecture.mjs --strict"
  }
}
