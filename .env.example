# .env.example for vxtpl - the authoritative reference for every supported
# variable. Copy to .env and fill in what you need. .env is git-ignored and never
# committed; on the deploy host the operative copy is /srv/md0/vxtpl/etc/.env
# (mode 600), delivered once from the ENV_FILE_BASE64 GitHub secret.
#
# vxtpl runs production only (ADR-002), so the values below are the prod values.
# An empty file is also valid: everything falls back to offline mocks for local
# dev, and those mocks are refused on a deployed stage (lib/deploy-stage.ts).

# --- App ---
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
# Host port on the deploy host (infra allocation). The container always listens
# on 3000; this is only the published side of the mapping.
APP_PUBLISH_PORT=3210

# Build provenance (APP_VERSION, GIT_SHA, BUILD_TIME, DEPLOY_STAGE) is NOT set
# here. It is baked into the image as ARG->ENV by portals/app/Dockerfile from
# values build.yml derives from the git ref, so that /api/health reports what was
# actually built rather than what someone typed. DEPLOY_STAGE in particular is
# what makes the mock-resolver guard work - overriding it in this file would
# defeat that guard, so do not add it.

# --- Database ---
# Two identities, and conflating them is the usual mistake. The db CONTAINER is
# created as its superuser/owner (POSTGRES_DB_OWNER, POSTGRES_PASSWORD); the APP
# connects as the least-privilege service role vxtpl_svc via DATABASE_URL, which
# has no DDL rights and only column-whitelisted writes. The vxtpl_svc password is
# set by the db-init workflow, which patches it into DATABASE_URL if it finds none.
POSTGRES_DB=vxturebiz_vxtpl_prod
POSTGRES_DB_OWNER=postgres              # container superuser, NOT the app's identity
POSTGRES_PASSWORD=                      # procure: the owner password (db container init)
DATABASE_URL=postgresql://vxtpl_svc:@vxtpl-db:5432/vxturebiz_vxtpl_prod
                                        # svc password: VXTPL_DB_SVC_PASSWORD, set by db-init

# --- Redis (RP session store) ---
REDIS_URL=redis://vxtpl-redis:6379

# --- Status dashboard (/status, /api/status) ---
STATUS_PAGE=public                      # public | authed (login required) | off
STATUS_SHOW_INFRA=on                    # on shows db host/name/role; off hides them

# --- C1: OIDC relying party -------------------------------------------------
# This client pair is ALSO the S2S credential. The token-exchange grant that
# mints tokens for Atlas, Runos and the platform authenticates with exactly this
# client_id/client_secret - there is no separate S2S credential to procure.
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=vxtpl
OIDC_CLIENT_SECRET=                     # procure: platform-issued client secret
OIDC_REDIRECT_URI=https://vxtpl.vxture.com/auth/callback
OIDC_SCOPES=openid profile email phone
OIDC_POST_LOGOUT_REDIRECT_URI=https://vxtpl.vxture.com/
OIDC_RP_ENABLED=on                      # off makes /auth/login answer 503 instead of dead-ending
RP_SESSION_TTL=2592000
RP_SESSION_COOKIE_NAME=__Host-vx_rp_session   # dev over http: vx_rp_session
NEXT_PUBLIC_APP_URL=https://vxtpl.vxture.com

# --- C2: entitlement --------------------------------------------------------
PLATFORM_API_URL=                       # internal-network base; unset -> Mock resolver (dev only)
PLATFORM_INTERNAL_AUTH_TOKEN=           # procure: shared internal-auth secret (S2S)
NEXT_PUBLIC_CONSOLE_URL=https://console.vxture.com

# --- C3: provisioning webhook + usage ---------------------------------------
PROVISION_WEBHOOK_SECRET=               # procure: VXTPL_PROVISION_WEBHOOK_SECRET
PROVISION_WEBHOOK_SECRET_NEXT=          # optional, second slot during rotation
INTERNAL_JOB_TOKEN=                     # gates POST /api/usage/flush

# --- Atlas (model supply) ---------------------------------------------------
# Base URL only. There is deliberately no ATLAS_S2S_TOKEN: platform S2S tokens
# live 300 seconds and cannot be refreshed, so a token pasted here would work for
# one manual test and 401 forever after. Tokens are minted per call from the
# OIDC client above (portals/app/app/lib/s2s-token.ts).
# Accepted host forms: https anywhere, or http to a private/tailnet/single-label
# host (e.g. http://worker-02:3100). http to a public host is refused.
ATLAS_API_URL=                          # unset -> Mock chat resolver (dev only)

# --- Runos (capability plane) -----------------------------------------------
# Same story - no RUNOS_S2S_TOKEN. Note that Runos's guard requires a `sub`
# claim, which only on-behalf-of tokens carry, so every Runos call rides a
# signed-in user session; there is no background path to Runos.
RUNOS_API_URL=                          # unset -> skills report "unavailable"

# --- Escape hatch -----------------------------------------------------------
# Allows the offline mocks to run on a deployed stage. For a first deploy that
# must come up before its credentials are issued. It serves fabricated
# entitlement and chat data - leave it unset unless that is what you mean.
# ALLOW_MOCK_ON_DEPLOY=on

# --- Local development only -------------------------------------------------
# Drive the mock entitlement resolver to any tier x status combination. Ignored
# on a deployed stage.
# MOCK_TIER=pro
# MOCK_STATUS=active
# MOCK_BUNDLED=false
